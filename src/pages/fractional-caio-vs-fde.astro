---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    question: "Should I hire a Fractional CAIO or a Fractional FDE?",
    answer:
      "If you need AI strategy, executive alignment, and governance, start with a Fractional CAIO. If you already know the bottleneck and need custom AI agents built and shipped into your CRM or ERP, start with a Fractional FDE. Many mid-market clients engage both—the CAIO sets the roadmap and the FDE ships the production systems.",
  },
  {
    question: "Can I start with one model and add the other later?",
    answer:
      "Yes. Most clients start with whichever role solves their most urgent operational bottleneck. Fractional CAIO and Fractional FDE are built by Richard McKellar to interlock cleanly so strategy and stack execution stay synchronized.",
  },
  {
    question: "What is the $999 AI Audit?",
    answer:
      "The $999 AI Audit is a 5–7 day diagnostic covering one priority workflow inside one core system. You receive an executive findings document with a concrete recommendation: Fractional CAIO, Fractional FDE, or Capital & Advisory.",
  },
  {
    question: "How do the Fractional CAIO and Fractional FDE pricing models compare?",
    answer:
      "Fractional CAIO engagements typically start at $5,000 per 90-day cycle under the C.A.P.™ Operating Model. Fractional FDE spans $7,500–$12,500 for a Diagnostic Audit, $20,000–$40,000 for a Pilot Deployment, and $12,000–$25,000/month for an Embedded Retainer—delivering measurable capability well below a $150K–$300K+ full-time hire.",
  },
];

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const serviceSchema = {
  "@type": "Service",
  "name": "Fractional CAIO vs Fractional FDE — AI Leadership Comparison",
  "serviceType": "AI Advisory & Forward Deployed Engineering Comparison",
  "url": "https://mckellar.dev/fractional-caio-vs-fde",
  "areaServed": ["New Jersey", "New York City", "Florida", "Connecticut", "Massachusetts", "Maryland"],
  "description":
    "Practical comparison by Richard McKellar in Morristown, NJ of Fractional Chief AI Officer (CAIO) governance vs. Fractional Forward Deployed Engineer (FDE) stack deployment.",
};
---

<BaseLayout
  title="Fractional CAIO vs Fractional FDE | Richard McKellar"
  description="Compare Fractional Chief AI Officer (strategy & 90-day roadmap) vs Fractional FDE (hands-on stack builds) with Richard McKellar in NJ & NYC."
  canonicalPath="/fractional-caio-vs-fde"
  ogType="website"
  faqSchema={faqSchema}
  serviceSchema={serviceSchema}
>
  <div class="w-full flex flex-col gap-14 animate-fade-in">
    <!-- Top Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--color-border)]">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline no-underline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
      <div class="flex items-center gap-3 text-xs font-mono">
        <a href="/fractional-caio" class="text-on-surface-muted hover:text-on-surface no-underline">Fractional CAIO</a>
        <span class="text-on-surface-subtle">/</span>
        <a href="/fractional-fde" class="text-on-surface-muted hover:text-on-surface no-underline">Fractional FDE</a>
        <span class="text-on-surface-subtle">/</span>
        <a href="/institute-for-ai-adoption" class="text-on-surface-muted hover:text-on-surface no-underline">Institute</a>
      </div>
    </div>

    <!-- 1. Hero -->
    <section class="exec-bento-card exec-grid-bg p-6 sm:p-10 flex flex-col items-center text-center gap-6">
      <span class="exec-badge exec-badge-indigo">Strategy vs. Implementation · Or Both</span>
      <h1 class="font-display font-bold text-3xl sm:text-5xl leading-[1.06] text-on-surface text-glow-primary max-w-4xl">
        Fractional CAIO vs Fractional FDE
      </h1>
      <p class="text-base sm:text-lg text-on-surface-muted max-w-2xl leading-relaxed">
        Two complementary models led by <a href="/richard-mckellar" class="text-accent font-semibold hover:underline no-underline">Richard McKellar</a> in Morristown, NJ. The CAIO sets governance, prioritization, and 90-day ROI accountability; the FDE embeds inside your stack to ship working AI systems.
      </p>

      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="https://calendar.mckellar.dev/richard/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="exec-btn-primary no-underline"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Book 30-Minute Scoping Call
        </a>
        <button
          type="button"
          data-inquiry-subject="CAIO vs FDE Inquiry"
          data-inquiry-source="caio-vs-fde-hero"
          class="exec-btn-secondary"
        >
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Get Help Choosing
        </button>
      </div>

      <div class="exec-telemetry-strip w-full mt-2">
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Entry Diagnostic</span>
          <span class="font-display font-bold text-lg text-on-surface">$999 AI Audit</span>
          <span class="text-[11px] text-on-surface-muted">1 workflow · 5–7 days</span>
        </div>
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Strategy &amp; Governance</span>
          <span class="font-display font-bold text-lg text-on-surface">CAIO From $5K</span>
          <span class="text-[11px] text-on-surface-muted">90-day C.A.P.™ Operating Model</span>
        </div>
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Stack Engineering</span>
          <span class="font-display font-bold text-lg text-on-surface">FDE From $7.5K</span>
          <span class="text-[11px] text-on-surface-muted">Diagnostic, Pilot &amp; Retainers</span>
        </div>
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Coverage</span>
          <span class="font-display font-bold text-lg text-on-surface">NJ · NYC · East Coast</span>
          <span class="text-[11px] text-on-surface-muted">NJ, NYC, FL, CT, MA, MD</span>
        </div>
      </div>
    </section>

    <!-- 2. Quick Decision -->
    <section class="flex flex-col gap-6">
      <div>
        <p class="exec-kicker mb-1.5">Quick Decision</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          Which One Do You Need?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="exec-bento-card exec-bento-card-violet flex flex-col gap-4">
          <span class="exec-badge exec-badge-violet w-fit">Strategy &amp; Governance</span>
          <h3 class="font-display font-bold text-xl text-on-surface">Choose Fractional CAIO if…</h3>
          <ul class="flex flex-col gap-2.5 text-sm text-on-surface-muted">
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> You need an AI strategy and prioritized roadmap, not ad-hoc tools</li>
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> Leadership needs an Executive AI Council and clear decision rights</li>
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> You require governance, vendor policy, and risk guardrails</li>
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> The CFO demands decision-gated ROI metrics in 90-day cycles</li>
          </ul>
          <a href="/fractional-caio" class="exec-btn-primary mt-auto w-full no-underline">
            Explore Fractional CAIO →
          </a>
        </div>

        <div class="exec-bento-card exec-bento-card-indigo flex flex-col gap-4">
          <span class="exec-badge exec-badge-indigo w-fit">Hands-On Stack Build</span>
          <h3 class="font-display font-bold text-xl text-on-surface">Choose Fractional FDE if…</h3>
          <ul class="flex flex-col gap-2.5 text-sm text-on-surface-muted">
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> You need production AI agents built and shipped, not just planned</li>
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> Salesforce, NetSuite, HubSpot, or lending CRMs need direct integration</li>
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> You want shadow-mode validation before full production cutover</li>
            <li class="flex items-start gap-2"><span class="text-accent font-mono">→</span> You need code, webhooks, and runbooks delivered on existing tools</li>
          </ul>
          <a href="/fractional-fde" class="exec-btn-primary mt-auto w-full no-underline">
            Explore Fractional FDE →
          </a>
        </div>
      </div>
    </section>

    <!-- 3. Side-by-Side Comparison Table -->
    <section class="flex flex-col gap-6">
      <div>
        <p class="exec-kicker mb-1.5">Side by Side</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          Full Executive Comparison
        </h2>
      </div>

      <div class="exec-table-wrap">
        <table class="exec-table">
          <thead>
            <tr>
              <th>Dimension</th>
              <th>Fractional CAIO</th>
              <th>Fractional FDE</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-semibold text-on-surface">Primary Focus</td>
              <td>Strategy, executive governance &amp; portfolio alignment</td>
              <td>Engineering architecture, API integration &amp; agent shipping</td>
            </tr>
            <tr>
              <td class="font-semibold text-on-surface">Primary Counterparts</td>
              <td>CEO, CFO, board, PE operating partners &amp; department heads</td>
              <td>Operations leads, internal IT, engineering &amp; frontline teams</td>
            </tr>
            <tr>
              <td class="font-semibold text-on-surface">Core Deliverables</td>
              <td>Executive AI Council, 90-day roadmap, risk charter &amp; ROI reviews</td>
              <td>Production AI agents, webhooks, telemetry &amp; engineering runbooks</td>
            </tr>
            <tr>
              <td class="font-semibold text-on-surface">Methodology</td>
              <td>C.A.P.™ Operating Model (Council → Align → Perform)</td>
              <td>Audit → Evaluate → Deploy (Shadow → Guarded Production)</td>
            </tr>
            <tr>
              <td class="font-semibold text-on-surface">Cadence</td>
              <td>90-day governance &amp; value-delivery cycles</td>
              <td>2–4 week diagnostics, 6–10 week pilots, 3–12+ mo retainers</td>
            </tr>
            <tr>
              <td class="font-semibold text-on-surface">Pricing</td>
              <td>Starting at $5,000 per 90-day cycle</td>
              <td>$7.5K–$12.5K diagnostic · $20K–$40K pilot · $12K–$25K/mo retainer</td>
            </tr>
            <tr>
              <td class="font-semibold text-on-surface">Stack Scope</td>
              <td>Vendor selection, data policy &amp; board-level ROI architecture</td>
              <td>Salesforce, NetSuite, HubSpot, SAP, custom REST APIs &amp; Hermes</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. Better Together -->
    <section class="flex flex-col gap-6">
      <div>
        <p class="exec-kicker mb-1.5">Full-Stack Execution</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          Better Together: CAIO + FDE
        </h2>
        <p class="text-sm text-on-surface-muted mt-1.5 max-w-2xl">
          Most growing organizations benefit from pairing both disciplines: the CAIO ensures you build the right initiatives under strict governance, while the FDE guarantees they ship cleanly into production.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="exec-bento-card exec-bento-card-violet">
          <span class="exec-badge exec-badge-violet mb-2">Layer 1 · Direction</span>
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">CAIO Sets the Roadmap</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Executive AI Council charter, risk controls, use-case scoring, vendor discipline, and 90-day C.A.P.™ ROI gates.
          </p>
        </div>
        <div class="exec-bento-card exec-bento-card-indigo">
          <span class="exec-badge exec-badge-indigo mb-2">Layer 2 · Execution</span>
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">FDE Ships the Systems</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Deep workflow audits, production agent builds, shadow-mode validation, existing-stack integration, and team handoff.
          </p>
        </div>
      </div>

      <div class="exec-bento-card exec-bento-card-emerald">
        <h3 class="font-display font-bold text-base text-on-surface mb-1.5">The Closed-Loop Operating Model</h3>
        <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
          Real deployment telemetry from FDE builds feeds directly into CAIO quarterly reviews, while CAIO governance keeps engineering focused strictly on revenue, margin, and compliance priorities. See live examples on our <a href="/case-studies" class="text-accent hover:underline no-underline font-medium">Case Studies</a> page.
        </p>
      </div>
    </section>

    <!-- 5. Investment Overview -->
    <section class="flex flex-col gap-6">
      <div>
        <p class="exec-kicker mb-1.5">Investment Overview</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          Three Ways to Start
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="exec-bento-card exec-bento-card-emerald flex flex-col gap-3">
          <span class="exec-badge exec-badge-emerald w-fit">Entry Point</span>
          <h3 class="font-display font-bold text-lg text-on-surface">$999 AI Audit</h3>
          <p class="text-xs text-on-surface-muted leading-relaxed">
            1 workflow in 1 core system over 5–7 days. Receive a findings doc recommending CAIO, FDE, or Capital &amp; Advisory.
          </p>
          <button
            type="button"
            data-inquiry-subject="$999 AI Audit Inquiry"
            data-inquiry-source="caio-vs-fde-audit"
            class="exec-btn-primary mt-auto w-full"
          >
            Book $999 AI Audit
          </button>
        </div>

        <div class="exec-bento-card exec-bento-card-violet flex flex-col gap-3">
          <span class="exec-badge exec-badge-violet w-fit">Strategy Path</span>
          <h3 class="font-display font-bold text-lg text-on-surface">CAIO: From $5K</h3>
          <p class="text-xs text-on-surface-muted leading-relaxed">
            90-day C.A.P.™ Operating Model cycles. Governance, AI Council, and executive alignment without a full-time hire.
          </p>
          <a href="/fractional-caio" class="exec-btn-secondary mt-auto w-full no-underline">
            Explore CAIO →
          </a>
        </div>

        <div class="exec-bento-card exec-bento-card-indigo flex flex-col gap-3">
          <span class="exec-badge exec-badge-indigo w-fit">Build Path</span>
          <h3 class="font-display font-bold text-lg text-on-surface">FDE: From $7.5K</h3>
          <p class="text-xs text-on-surface-muted leading-relaxed">
            Diagnostic audits, pilot builds, and embedded engineering retainers on your existing Salesforce, NetSuite, or HubSpot stack.
          </p>
          <a href="/fractional-fde" class="exec-btn-secondary mt-auto w-full no-underline">
            Explore FDE →
          </a>
        </div>
      </div>
    </section>

    <!-- 6. Visible FAQ Accordion (Matches faqSchema 1:1) -->
    <section id="faq" class="flex flex-col gap-5">
      <div>
        <p class="exec-kicker mb-1.5">FAQ</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          Common Comparison Questions
        </h2>
      </div>
      <div class="exec-faq-list">
        {faqs.map((faq, index) => (
          <details class="exec-faq-item" open={index === 0}>
            <summary class="exec-faq-trigger">{faq.question}</summary>
            <div class="exec-faq-panel">{faq.answer}</div>
          </details>
        ))}
      </div>
    </section>

    <!-- 7. Final CTA -->
    <section class="exec-bento-card exec-bento-card-indigo p-6 sm:p-8 flex flex-col items-center text-center gap-4">
      <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
        Not Sure Which Path Fits Best?
      </h2>
      <p class="text-sm text-on-surface-muted max-w-xl">
        Book a 30-minute call with Richard McKellar (Morristown, NJ / NJ, NYC, FL, CT, MA, MD) to map your workflows and select the cleanest path forward.
      </p>
      <div class="flex flex-wrap gap-3 justify-center pt-1">
        <a
          href="https://calendar.mckellar.dev/richard/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="exec-btn-primary no-underline"
        >
          Book 30-Minute Scoping Call
        </a>
        <button
          type="button"
          data-inquiry-subject="CAIO vs FDE Inquiry"
          data-inquiry-source="caio-vs-fde-bottom"
          class="exec-btn-secondary"
        >
          Get Help Choosing
        </button>
      </div>
    </section>
  </div>
</BaseLayout>
