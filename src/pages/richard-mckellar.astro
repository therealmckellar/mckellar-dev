---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = [...allPosts]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

const faqs = [
  {
    q: "Who is Richard McKellar?",
    a: "Richard McKellar (handles: therealmckellar, rmckellar) is a Fractional Chief AI Officer (CAIO), Forward Deployed Engineer (FDE), and alternative business finance executive based in Morristown, New Jersey. He serves as Chief Revenue Officer (CRO) of My Commercial Funding, Founder & Chief AI Officer of The Institute for AI Adoption, and previously served as Vice President & Executive Board Member at Whetstone Holdings."
  },
  {
    q: "Where is Richard McKellar based, and what regions does he serve?",
    a: "Richard McKellar is headquartered in Morristown, New Jersey (NJ). He works hands-on with organizations across New Jersey, New York City (NYC), Florida (FL), Connecticut (CT), Massachusetts (MA), and Maryland (MD), as well as global advisory and virtual engagements."
  },
  {
    q: "What is Richard McKellar's role at My Commercial Funding?",
    a: "Richard McKellar is the Chief Revenue Officer (CRO) at My Commercial Funding (mycommercialfunding.com), a commercial lending marketplace and Merchant Cash Advance (MCA) platform, where he oversees sales pipelines, commission systems, renewal cycles, and syndication network operations."
  },
  {
    q: "Was Richard McKellar an executive at Whetstone Holdings and Everest Funding?",
    a: "Yes. Richard McKellar previously served as Vice President and Executive Board Member at Whetstone Holdings, which operated prominent DBA alternative finance brands including Everest Funding (Everest Business Funding), Vader Funding, and Granite Mountain Funding. During his 15+ years in alternative lending, he personally funded over $100M+ in MCA and revenue-based financing (RBF) transactions."
  },
  {
    q: "What is The Institute for AI Adoption?",
    a: "The Institute for AI Adoption is Richard McKellar's venture dedicated to facilitating operational AI adoption inside mid-market companies and government organizations. Rather than acting as an external certification body, the Institute deploys the proprietary 90-day C.A.P.™ Operating Model (Council, Align, Perform) to establish internal Executive AI Councils, prioritize ROI-backed workflows, and transfer operational ownership to internal teams."
  },
  {
    q: "What is the difference between Richard McKellar's Fractional CAIO and Fractional FDE services?",
    a: "Fractional CAIO (starting at $5,000 per 90-day cycle) provides executive AI strategy, governance charters, Executive AI Council stand-up, and CFO-defensible ROI prioritization. Fractional FDE ($7,500–$12,500 diagnostic audits, $20,000–$40,000 pilot deployments, and $12,000–$25,000/month embedded retainers) embeds directly into your existing stack—such as Salesforce, NetSuite, HubSpot, SAP, or custom APIs—to ship production AI agents without rip-and-replace migrations. Teams can start with a $999 AI Audit covering 1 workflow in 1 system over 5–7 days."
  },
  {
    q: "What other ventures and affiliations is Richard McKellar connected to?",
    a: "In addition to My Commercial Funding, The Institute for AI Adoption, mckellar.dev, and his historical executive tenure at Whetstone Holdings, Richard McKellar maintains verified business affiliations with Robbi Promotional (robbipromotional.com) and Fathom Realty."
  },
  {
    q: "What commercial lending and direct funding advisory services does Richard McKellar offer?",
    a: "Through Capital & Advisory on mckellar.dev, Richard advises investors, capital syndicates, and operators on direct lending entity setup and launch, proprietary risk grading models, warehouse lines of credit, syndication structures, ISO channel strategy, Salesforce/CRM scaling, and independent borrower-side loan offer review."
  },
  {
    q: "How do you contact or book Richard McKellar?",
    a: "You can schedule a 30-minute call directly via https://calendar.mckellar.dev/richard/30min, send a message on mckellar.dev, email richard@mckellar.dev, or connect on LinkedIn (linkedin.com/in/richardmckellar) and GitHub (github.com/therealmckellar)."
  }
];

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const profileSchema = {
  "@type": "ProfilePage",
  "@id": "https://mckellar.dev/richard-mckellar#profile",
  "url": "https://mckellar.dev/richard-mckellar",
  "name": "Richard McKellar — Official Profile, Work History & Advisory",
  "dateCreated": "2026-06-10",
  "dateModified": "2026-11-16",
  "mainEntity": { "@id": "https://mckellar.dev/#richard-mckellar" },
  "significantLink": [
    "https://mckellar.dev/about",
    "https://mckellar.dev/ventures",
    "https://mckellar.dev/case-studies",
    "https://mckellar.dev/speaking-and-media",
    "https://mckellar.dev/fractional-caio",
    "https://mckellar.dev/fractional-fde",
    "https://mckellar.dev/institute-for-ai-adoption",
    "https://mycommercialfunding.com",
    "https://www.linkedin.com/in/richardmckellar",
    "https://github.com/therealmckellar"
  ]
};
