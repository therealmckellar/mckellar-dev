---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    question: "What is The Institute for AI Adoption?",
    answer:
      "The Institute for AI Adoption is Richard McKellar's venture dedicated to facilitating operational AI adoption inside mid-market companies and government agencies. It deploys the proprietary 90-day C.A.P.™ Operating Model (Council, Align, Perform) to establish internal AI governance, prioritize high-ROI workflows, and deliver measurable outcomes.",
  },
  {
    question: "Is the Institute a standards or certification body?",
    answer:
      "No. The Institute facilitates real operational adoption inside your organization—it does not sell external certificates or public credentials. The value is the working governance and operating model built inside your teams. Likewise, the Executive AI Council is an internal governance body stood up for each client during Phase 1 of C.A.P.™, not an external membership club.",
  },
  {
    question: "How does The Institute relate to Richard McKellar's Fractional Chief AI Officer practice?",
    answer:
      "The Fractional Chief AI Officer (CAIO) practice is the primary executive delivery vehicle for The Institute's methodology. Every Fractional CAIO engagement runs on the C.A.P.™ Operating Model with governance, decision gates, and ROI reporting built in from day one.",
  },
  {
    question: "Who should engage with The Institute for AI Adoption?",
    answer:
      "Mid-market manufacturers, professional services firms, PE-backed portfolio companies, family offices, and government agencies across New Jersey (Morristown, NJ headquarters), New York City, Florida, Connecticut, Massachusetts, and Maryland that face AI adoption mandates without an internal operating system.",
  },
];

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const serviceSchema = {
  "@type": "Service",
  "name": "The Institute for AI Adoption — C.A.P. Operating Model Facilitation",
  "serviceType": "Operational AI Adoption Facilitation & Executive Governance",
  "url": "https://mckellar.dev/institute-for-ai-adoption",
  "brand": {
    "@type": "Organization",
    "name": "The Institute for AI Adoption",
    "url": "https://mckellar.dev/institute-for-ai-adoption",
    "founder": {
      "@id": "https://mckellar.dev/#richard-mckellar",
    },
  },
  "areaServed": ["New Jersey", "New York City", "Florida", "Connecticut", "Massachusetts", "Maryland"],
  "description":
    "Founded by Richard McKellar in Morristown, NJ, The Institute for AI Adoption facilitates operational AI adoption inside companies and governments via the 90-day C.A.P. Operating Model and Fractional CAIO leadership.",
};
---

<BaseLayout
  title="The Institute for AI Adoption | Richard McKellar"
  description="Founded by Richard McKellar in Morristown, NJ, The Institute for AI Adoption helps companies & agencies install governed AI via the 90-day C.A.P. model."
  canonicalPath="/institute-for-ai-adoption"
  ogType="website"
  faqSchema={faqSchema}
  serviceSchema={serviceSchema}
>
  <div class="w-full flex flex-col gap-14 animate-fade-in">
    <!-- Top Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--color-border)]">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline no-underline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
      <div class="flex items-center gap-3 text-xs font-mono">
        <a href="/fractional-caio" class="text-on-surface-muted hover:text-on-surface no-underline">Fractional CAIO</a>
        <span class="text-on-surface-subtle">/</span>
        <a href="/ventures" class="text-on-surface-muted hover:text-on-surface no-underline">Ventures</a>
        <span class="text-on-surface-subtle">/</span>
        <a href="/case-studies" class="text-on-surface-muted hover:text-on-surface no-underline">Case Studies</a>
      </div>
    </div>

    <!-- 1. Hero -->
    <section class="exec-bento-card exec-grid-bg p-6 sm:p-10 flex flex-col items-center text-center gap-6">
      <span class="exec-badge exec-badge-violet">AI Adoption · Facilitation · Executive Governance</span>
      <h1 class="font-display font-bold text-3xl sm:text-5xl leading-[1.06] text-on-surface text-glow-primary max-w-3xl">
        The Institute for AI Adoption
      </h1>
      <p class="text-base sm:text-lg text-on-surface-muted max-w-2xl leading-relaxed">
        Founded by <a href="/richard-mckellar" class="text-accent font-semibold hover:underline no-underline">Richard McKellar</a> in Morristown, NJ to facilitate operational AI adoption inside companies and governments. We install the 90-day <strong class="text-on-surface">C.A.P.™ Operating Model</strong> to stand up governance, align priorities, and measure real ROI.
      </p>

      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="https://calendar.mckellar.dev/richard/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="exec-btn-primary no-underline"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Book a 30-Min Call
        </a>
        <a href="/fractional-caio" class="exec-btn-secondary no-underline">
          Explore Fractional CAIO
        </a>
        <button
          type="button"
          data-inquiry-subject="The Institute for AI Adoption Inquiry"
          data-inquiry-source="institute-hero"
          class="exec-btn-secondary"
        >
          Send a Message
        </button>
      </div>

      <div class="exec-telemetry-strip w-full mt-2">
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Methodology</span>
          <span class="font-display font-bold text-lg text-on-surface">C.A.P.™ Model</span>
          <span class="text-[11px] text-on-surface-muted">Council · Align · Perform</span>
        </div>
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Governance</span>
          <span class="font-display font-bold text-lg text-on-surface">Executive AI Council</span>
          <span class="text-[11px] text-on-surface-muted">Internal decision rights locked</span>
        </div>
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Delivery Vehicle</span>
          <span class="font-display font-bold text-lg text-on-surface">Fractional CAIO</span>
          <span class="text-[11px] text-on-surface-muted">Operator embedded in your org</span>
        </div>
        <div class="exec-telemetry-cell text-left">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Territory</span>
          <span class="font-display font-bold text-lg text-on-surface">NJ · NYC · East Coast</span>
          <span class="text-[11px] text-on-surface-muted">NJ, NYC, FL, CT, MA, MD</span>
        </div>
      </div>
    </section>

    <!-- 2. The Problem -->
    <section class="flex flex-col gap-6">
      <div>
        <p class="exec-kicker mb-1.5">The Institutional Gap</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          Everyone Feels AI Pressure. Few Have an Operating System.
        </h2>
        <p class="text-sm text-on-surface-muted mt-1.5 max-w-2xl">
          Boards, investors, and public stakeholders demand AI outcomes—yet most organizations operate without a shared framework, governance backbone, or measurable ROI cadence.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="exec-bento-card">
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">No Shared Language</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Executives, operators, and IT teams talk past each other, causing high-leverage AI initiatives to stall at approval gates.
          </p>
        </div>
        <div class="exec-bento-card">
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">Governance Vacuum</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Risk, security, and vendor rules are bolted on retroactively instead of embedded before production rollout.
          </p>
        </div>
        <div class="exec-bento-card">
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">Pilot Graveyard</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Isolated demos impress leadership once, then fade away because no internal operating owner exists.
          </p>
        </div>
        <div class="exec-bento-card">
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">Unmeasured Spend</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Budgets evaporate when teams cannot tie AI software and engineering hours back to auditable P&amp;L impact.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Facilitation vs Certification -->
    <section class="flex flex-col gap-6">
      <div>
        <p class="exec-kicker mb-1.5">Operational Philosophy</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          We Facilitate Adoption — We Don't Certify It
        </h2>
        <p class="text-sm text-on-surface-muted mt-1.5 max-w-2xl">
          The Institute exists to make AI adoption operational inside your organization—never as an external badge or theoretical seminar.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="exec-bento-card exec-bento-card-violet">
          <span class="exec-badge exec-badge-violet mb-2">Role 01</span>
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">Embedded Operator</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Richard embeds inside leadership and department workflows to stand up your internal operating model directly.
          </p>
        </div>
        <div class="exec-bento-card exec-bento-card-indigo">
          <span class="exec-badge exec-badge-indigo mb-2">Role 02</span>
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">Proprietary IP Owner</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            The C.A.P.™ Operating Model is repeatable, battle-tested intellectual property designed for 90-day enterprise cycles.
          </p>
        </div>
        <div class="exec-bento-card exec-bento-card-emerald">
          <span class="exec-badge exec-badge-emerald mb-2">Role 03</span>
          <h3 class="font-display font-bold text-base text-on-surface mb-1.5">Governance Architect</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            We lock decision rights, policy boundaries, and executive sponsorship before a single workflow enters production.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. C.A.P. Framework Phases -->
    <section class="flex flex-col gap-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <p class="exec-kicker mb-1.5">The C.A.P.™ Framework</p>
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
            90-Day Adoption Architecture
          </h2>
        </div>
        <a href="/blog/richard-mckellar-ai-adoption-framework-nj" class="text-xs font-mono uppercase tracking-wider text-accent hover:underline no-underline">
          Read the C.A.P.™ Field Guide →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="exec-bento-card exec-bento-card-violet flex flex-col gap-2">
          <span class="exec-badge exec-badge-violet w-fit">Days 1–30 · Council</span>
          <h3 class="font-display font-bold text-lg text-on-surface">Stand Up the Executive AI Council</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Define decision rights, baseline current state, and establish your governance charter with executive sponsorship locked in.
          </p>
        </div>
        <div class="exec-bento-card exec-bento-card-indigo flex flex-col gap-2">
          <span class="exec-badge exec-badge-indigo w-fit">Days 31–60 · Align</span>
          <h3 class="font-display font-bold text-lg text-on-surface">Prioritize the Value Roadmap</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Score candidate use cases by margin impact and technical feasibility. Assign internal owners, KPIs, and CFO decision gates.
          </p>
        </div>
        <div class="exec-bento-card exec-bento-card-emerald flex flex-col gap-2">
          <span class="exec-badge exec-badge-emerald w-fit">Days 61–90 · Perform</span>
          <h3 class="font-display font-bold text-lg text-on-surface">Deploy, Measure &amp; Transfer</h3>
          <p class="text-xs sm:text-sm text-on-surface-muted leading-relaxed">
            Ship priority workflows into production, audit measured ROI, and transfer playbooks so capability compounds internally.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. Who It's For (Crisp SVGs, ZERO emojis) -->
    <section class="flex flex-col gap-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <p class="exec-kicker mb-1.5">Who It's For</p>
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
            Built for Organizations Seeking Measurable Outcomes
          </h2>
        </div>
        <span class="exec-badge exec-badge-indigo w-fit">NJ · NYC · FL · CT · MA · MD</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="link-row cursor-default">
          <div class="link-row-icon text-accent">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-display font-semibold text-sm text-on-surface">Mid-Market Manufacturers</p>
            <p class="text-xs text-on-surface-muted mt-0.5">Operationalizing AI on the floor, across quoting, and throughout ERP workflows.</p>
          </div>
        </div>

        <div class="link-row cursor-default">
          <div class="link-row-icon text-accent">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-display font-semibold text-sm text-on-surface">Professional &amp; Financial Services</p>
            <p class="text-xs text-on-surface-muted mt-0.5">Increasing delivery speed and underwriting leverage without linear headcount growth.</p>
          </div>
        </div>

        <div class="link-row cursor-default">
          <div class="link-row-icon text-telemetry">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-display font-semibold text-sm text-on-surface">PE-Backed Portfolio Companies</p>
            <p class="text-xs text-on-surface-muted mt-0.5">Installing standardized governance and verifiable EBITDA-oriented AI operating plans.</p>
          </div>
        </div>

        <div class="link-row cursor-default">
          <div class="link-row-icon text-gold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-display font-semibold text-sm text-on-surface">Family Offices &amp; Public Agencies</p>
            <p class="text-xs text-on-surface-muted mt-0.5">Governments and investment offices seeking governed adoption without building an internal R&amp;D lab.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Visible FAQ Accordion (Matches faqSchema 1:1) -->
    <section id="faq" class="flex flex-col gap-5">
      <div>
        <p class="exec-kicker mb-1.5">FAQ</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
          Questions About The Institute for AI Adoption
        </h2>
      </div>
      <div class="exec-faq-list">
        {faqs.map((faq, index) => (
          <details class="exec-faq-item" open={index === 0}>
            <summary class="exec-faq-trigger">{faq.question}</summary>
            <div class="exec-faq-panel">{faq.answer}</div>
          </details>
        ))}
      </div>
    </section>

    <!-- 7. Final CTA -->
    <section class="exec-bento-card exec-bento-card-violet p-6 sm:p-8 flex flex-col items-center text-center gap-4">
      <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface">
        Put an Operating Model Behind Your AI Adoption.
      </h2>
      <p class="text-sm text-on-surface-muted max-w-xl">
        Book a 30-minute call with Richard McKellar in Morristown, NJ (or remotely across NJ, NYC, FL, CT, MA, MD) to roll out the C.A.P.™ Operating Model inside your team.
      </p>
      <div class="flex flex-wrap gap-3 justify-center pt-1">
        <a
          href="https://calendar.mckellar.dev/richard/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="exec-btn-primary no-underline"
        >
          Book a 30-Min Call
        </a>
        <button
          type="button"
          data-inquiry-subject="The Institute for AI Adoption Inquiry"
          data-inquiry-source="institute-bottom"
          class="exec-btn-secondary"
        >
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Send a Message
        </button>
      </div>
    </section>
  </div>
</BaseLayout>
