---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader';
import SpokeCard from '../components/SpokeCard';
import { openInquiry } from '../lib/inquiry';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who is Richard McKellar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Richard McKellar is an AI adoption consultant, sales automation builder, and Merchant Cash Advance (MCA) advisory specialist based in Morristown, New Jersey."
      }
    },
    {
      "@type": "Question",
      "name": "What is Richard McKellar's background in the Merchant Cash Advance industry?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Richard McKellar has over 15 years of experience in alternative business lending and MCA platform advisory, including serving as a VP and Executive Board Member at Whetstone Holdings. He has personally funded over $100M+ in MCA/RBF transactions."
      }
    },
    {
      "@type": "Question",
      "name": "What AI adoption services does Richard McKellar provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Richard McKellar implements custom context-aware AI agent structures, automates lead triage and routing, integrates AI with collaboration channels, and trains workforces on adoption into daily workflows."
      }
    },
    {
      "@type": "Question",
      "name": "Where is Richard McKellar based?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Richard McKellar is based in Morristown, New Jersey (NJ), USA, and is available for global technology consulting and advisory projects."
      }
    }
  ]
};
---

<BaseLayout
  title="Richard McKellar | mckellar.dev — AI, Funding & Multi-Venture Advisory"
  description="Richard McKellar is a technology consultant and advisor in Morristown, NJ. Hub for AI agent integration, sales workflow automation, and Merchant Cash Advance platform advisory."
  canonicalPath="/"
  faqSchema={faqSchema}
>
  <!-- 1. Profile & Hero -->
  <section id="home" class="pt-8 md:pt-16 flex flex-col items-center">
    <ProfileHeader />
    
    {/* One-liner positioning */}
    <p class="text-sm text-on-surface-muted mt-3 text-center max-w-lg animate-fade-in" style="animation-delay: 320ms;">
      Fractional AI Executive · Multi-Venture Founder
    </p>

    <!-- Central CTAs row -->
    <div class="flex flex-row flex-wrap gap-3 justify-center mt-5 px-1 animate-fade-in" style="animation-delay: 350ms;">
      <a
        href="https://calendar.mckellar.dev/richard/30min"
        target="_blank"
        rel="noopener noreferrer"
        id="cta-schedule-call"
        class="btn-primary py-2 px-4 text-xs font-semibold shadow-neon-primary no-underline"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Schedule Call
      </a>
      
      <button
        type="button"
        onClick={() => openInquiry({ subject: 'Advisory Discussion', source: 'home-hero' })}
        class="inline-flex items-center justify-center gap-1.5 py-2 px-4 rounded-lg font-semibold text-xs glass-button hover:bg-white/10 active:scale-[0.98] transition-all"
      >
        <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Inquire
      </button>
    </div>
  </section>

  <!-- 2. Advisory Areas Section -->
  <section id="focus" class="flex flex-col gap-6 animate-fade-in" style="animation-delay: 400ms;">
    <div class="text-center sm:text-left">
      <p class="section-label mb-2">Core Competencies</p>
      <h2 class="font-display font-extrabold text-[28px] sm:text-[34px] leading-tight text-on-surface">
        Strategic Advisory Areas
      </h2>
      <p class="text-sm text-on-surface-muted mt-2 max-w-xl">
        Richard provides targeted advisory services for technology adoption and alternative asset finance.
      </p>
    </div>

    <!-- 3-column responsive layout -->
    <div class="max-w-5xl mx-auto w-full mt-2">
      
      {/* Routing block — "Not sure where to start?" */}
      <div class="glass-card rounded-xl p-5 border-[var(--color-border)] mb-6 text-center">
        <p class="section-label mb-2">Not sure where to start?</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-3">
          <a href="/fractional-fde" class="flex flex-col items-center gap-1.5 p-3 rounded-lg hover:bg-white/5 transition-colors no-underline">
            <span class="text-lg">⚡</span>
            <span class="text-xs font-semibold text-on-surface">AI Deployment</span>
            <span class="text-[10px] text-on-surface-muted">Build agents into your systems</span>
          </a>
          <a href="/fractional-caio" class="flex flex-col items-center gap-1.5 p-3 rounded-lg hover:bg-white/5 transition-colors no-underline">
            <span class="text-lg">🎯</span>
            <span class="text-xs font-semibold text-on-surface">AI Strategy</span>
            <span class="text-[10px] text-on-surface-muted">Roadmap, governance, ROI</span>
          </a>
          <a href="#capital-advisory" class="flex flex-col items-center gap-1.5 p-3 rounded-lg hover:bg-white/5 transition-colors no-underline">
            <span class="text-lg">💰</span>
            <span class="text-xs font-semibold text-on-surface">Funding & Capital</span>
            <span class="text-[10px] text-on-surface-muted">MCA, lending, brokerage</span>
          </a>
          <a href="mailto:richard@mckellar.dev?subject=Promo%20%26%20Merch" class="flex flex-col items-center gap-1.5 p-3 rounded-lg hover:bg-white/5 transition-colors no-underline">
            <span class="text-lg">🎨</span>
            <span class="text-xs font-semibold text-on-surface">Promo & Merch</span>
            <span class="text-[10px] text-on-surface-muted">Branded products & apparel</span>
          </a>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
        
        {/* Practice A: AI Adoption & Integration */}
        <div class="flex flex-col">
          <SpokeCard
            accent="blue"
            title="AI Consulting & Workflows"
            description="Implementing AI integrations and training workforces on daily adoption. Richard delivers bespoke automations, AI adoption strategies, and technical sales training to streamline operational overhead and accelerate pipelines."
            links={[
              { label: 'AI Agent / Business Integration', href: 'https://hermes.mckellar.dev' },
              { label: 'Workforce Training & Enablement', href: 'mailto:richard@mckellar.dev?subject=Workforce%20AI%20Training' },
              { label: 'AI Strategy & Insights Blog', href: '/blog' },
              { label: 'View Advisory Scope Below', href: 'mailto:richard@mckellar.dev?subject=AI Advisory' },
            ]}
            useCases={[
              "AI and Agent Adoption and Integration",
              "Automated Lead Triage & Routing",
              "Custom Context-Aware Agent Deployments",
              "Workflow Integration & Workforce Training"
            ]}
            animationDelay={100}
            ctaLabel="Inquire about AI Consulting"
            onCtaClick={() => openInquiry({ subject: 'AI Consulting Inquiry', source: 'spoke-ai-consulting' })}
          />
        </div>

        {/* Capital & Advisory — combined MCA + Brokerage + Funding Consulting */}
        <div class="flex flex-col" id="capital-advisory">
          <SpokeCard
            accent="gold"
            title="Capital & Advisory"
            badge="15+ Years"
            description="15+ years in alternative lending and commercial funding. Direct lending advisory, brokerage operations, and independent borrower-side loan offer review."
            links={[
              { label: 'My Commercial Funding', href: 'https://mycommercialfunding.com' },
              { label: 'MCA Direct Lending Advisory', href: 'mailto:richard@mckellar.dev?subject=Direct%20Lending%20Setup' },
              { label: 'MCA Brokerage Advisory', href: 'mailto:richard@mckellar.dev?subject=Brokerage%20Setup' },
              { label: 'Borrower-Side Funding Review', href: 'mailto:richard@mckellar.dev?subject=Funding%20Offer%20Review' },
            ]}
            useCases={[
              "Direct lending platform setup & scaling",
              "Brokerage operations & ISO networks",
              "Underwriting & risk model refinement",
              "CRM setup (Salesforce, HubSpot, custom)",
              "Loan offer review & term benchmarking",
              "Warehouse lines & syndication"
            ]}
            animationDelay={200}
            ctaLabel="Inquire about Capital & Advisory"
            onCtaClick={() => openInquiry({ subject: 'Capital & Advisory Inquiry', source: 'spoke-capital-advisory' })}
          />
        </div>

        {/* Practice F: Fractional Chief AI Officer */}
        <div class="flex flex-col">
          <SpokeCard
            accent="purple"
            title="Fractional Chief AI Officer"
            badge="Focus"
            description="A senior AI operator on a fractional basis. Richard builds a clear 90-day AI operating plan with governance, prioritization, and executive accountability — measurable ROI without a full-time CAIO hire."
            links={[
              { label: 'Explore the Fractional CAIO Practice', href: '/fractional-caio' },
              { label: 'Schedule Executive Briefing', href: 'https://calendar.mckellar.dev/richard/30min' },
              { label: 'Inquire about Fractional CAIO', href: 'mailto:richard@mckellar.dev?subject=Fractional%20Chief%20AI%20Officer' },
            ]}
            useCases={[
              "Executive AI Council & governance charter",
              "Prioritized 90-day AI operating plan",
              "ROI measurement tied to decision gates",
              "Workforce enablement & ownership transfer"
            ]}
            animationDelay={600}
            ctaLabel="Inquire about Fractional CAIO"
            onCtaClick={() => openInquiry({ subject: 'Fractional CAIO Inquiry', source: 'spoke-fractional-caio' })}
          />
        </div>
        {/* Practice G: Fractional Forward Deployed Engineer */}
        <div class="flex flex-col">
          <SpokeCard
            accent="blue"
            title="Fractional FDE"
            badge="New"
            description="Embedded AI engineer to map workflows and deploy agents on your existing stack. Diagnostic audits, pilot builds, and ongoing retainers."
            links={[
              { label: 'Explore the Fractional FDE Practice', href: '/fractional-fde' },
              { label: 'Book FDE Scoping Call', href: 'https://calendar.mckellar.dev/richard/30min' },
              { label: 'Inquire about Fractional FDE', href: 'mailto:richard@mckellar.dev?subject=Fractional%20FDE' },
            ]}
            useCases={[
              "AI workflow audit & ROI matrix",
              "Custom agent build on existing stack",
              "Shadow → production deployment",
              "Documentation & team handoff"
            ]}
            animationDelay={700}
            ctaLabel="Inquire about Fractional FDE"
            onCtaClick={() => openInquiry({ subject: 'Fractional FDE Inquiry', source: 'spoke-fractional-fde' })}
          />
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Ventures Section -->
  <section id="ventures" class="flex flex-col gap-5 animate-fade-in" style="animation-delay: 450ms;">
    <div>
      <h2 class="font-display font-bold text-xl sm:text-2xl text-on-surface">
        Current Ventures
      </h2>
    </div>

    <a
      href="https://mycommercialfunding.com"
      target="_blank"
      rel="me author noopener noreferrer"
      id="link-my-commercial-funding"
      class="link-row hover:scale-[1.005] bg-gradient-to-r from-amber-500/[0.02] to-transparent border-amber-500/10 hover:border-amber-500/30 hover:shadow-[0_0_20px_rgba(245,158,11,0.15)] transition-all duration-300 no-underline"
    >
      <div class="link-row-icon bg-amber-500/10 border-amber-500/20 text-amber-500">
        <span aria-hidden="true">💼</span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="font-display font-semibold text-sm sm:text-base text-on-surface leading-snug">
          My Commercial Funding
        </p>
        <p class="text-xs text-on-surface-muted mt-0.5 font-mono uppercase tracking-wider">
          Chief Revenue Officer · Premium MCA Platform
        </p>
      </div>
      <svg
        class="flex-shrink-0 w-4 h-4 text-on-surface-subtle transition-transform duration-200"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <div
      class="link-row bg-gradient-to-r from-purple-500/[0.02] to-transparent border-purple-500/10 hover:border-purple-500/30 hover:shadow-[0_0_20px_rgba(168,85,247,0.15)] transition-all duration-300"
    >
      <div class="link-row-icon bg-purple-500/10 border-purple-500/20 text-purple-400">
        <span aria-hidden="true">🎓</span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="font-display font-semibold text-sm sm:text-base text-on-surface leading-snug">
          The Institute for AI Adoption
        </p>
        <p class="text-xs text-on-surface-muted mt-0.5 font-mono uppercase tracking-wider">
          Chief AI Officer · AI Adoption Facilitator (Companies & Governments)
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
