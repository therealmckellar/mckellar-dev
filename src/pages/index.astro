---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader';
import SpokeCard from '../components/SpokeCard';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const featuredPosts = [...allPosts]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const categoryMeta: Record<'ai' | 'funding' | 'strategy', { label: string; badgeClass: string }> = {
  ai: { label: 'AI Insights', badgeClass: 'exec-badge exec-badge-indigo' },
  funding: { label: 'Merchant Funding', badgeClass: 'exec-badge exec-badge-gold' },
  strategy: { label: 'Strategy & Growth', badgeClass: 'exec-badge exec-badge-violet' },
};

const faqs = [
  {
    question: "Who is Richard McKellar?",
    answer:
      "Richard McKellar is a Fractional Chief AI Officer (CAIO), Fractional Forward Deployed Engineer (FDE), Chief Revenue Officer at My Commercial Funding, Founder of The Institute for AI Adoption, and former Vice President & Executive Board Member at Whetstone Holdings based in Morristown, New Jersey.",
  },
  {
    question: "What is Richard McKellar's background in the Merchant Cash Advance (MCA) industry?",
    answer:
      "Richard McKellar has over 15 years of executive experience in alternative business lending and Merchant Cash Advance (MCA) / Revenue-Based Financing (RBF) platforms. As a former VP and Executive Board Member at Whetstone Holdings (DBA Everest Funding, Vader Funding, and Granite Mountain Funding), he personally funded over $100M+ in transactions and now leads revenue operations as CRO of My Commercial Funding.",
  },
  {
    question: "What is the difference between Richard McKellar's Fractional CAIO and Fractional FDE practices?",
    answer:
      "A Fractional Chief AI Officer (CAIO) establishes executive AI governance, stands up an internal Executive AI Council, and runs a prioritized 90-day C.A.P.™ Operating Model (starting at $5,000 per cycle). A Fractional Forward Deployed Engineer (FDE) embeds directly into your engineering and operations stack—Salesforce, NetSuite, HubSpot, SAP, or lending CRMs—to audit workflows and ship production AI agents without rip-and-replace migrations.",
  },
  {
    question: "What is The Institute for AI Adoption?",
    answer:
      "The Institute for AI Adoption is Richard McKellar's venture dedicated to facilitating operational AI adoption inside mid-market companies and government agencies. Rather than issuing external certificates, the Institute deploys the proprietary 90-day C.A.P.™ Operating Model (Council, Align, Perform) so client teams build defensible ROI and internal ownership.",
  },
  {
    question: "Where is Richard McKellar based and which regions does he serve?",
    answer:
      "Richard McKellar is headquartered in Morristown, New Jersey (NJ), serving organizations across New Jersey, New York City (NYC) and the Tri-State corridor, Florida (FL), Connecticut (CT), Massachusetts (MA), Maryland (MD), and global remote advisory engagements.",
  },
];

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<BaseLayout
  title="Richard McKellar | Fractional CAIO, FDE & Funding Advisor"
  description="Richard McKellar in Morristown, NJ: Fractional CAIO, Forward Deployed Engineer, CRO at My Commercial Funding & Founder of The Institute for AI Adoption."
  canonicalPath="/"
  ogType="website"
  faqSchema={faqSchema}
>
  <!-- 1. Sovereign Executive Hero -->
  <section id="home" class="flex flex-col gap-6 pt-2">
    <ProfileHeader variant="asymmetric" showRule={false} />

    <!-- Hero Action Row -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
      <a
        href="https://calendar.mckellar.dev/richard/30min"
        target="_blank"
        rel="noopener noreferrer"
        id="cta-schedule-call"
        class="exec-btn-primary no-underline"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Schedule a Call
      </a>

      <button
        type="button"
        data-inquiry-subject="General Advisory Inquiry"
        data-inquiry-source="home-hero"
        class="exec-btn-secondary"
      >
        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Send a Message
      </button>

      <a
        href="/richard-mckellar"
        class="exec-btn-gold no-underline"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Full Profile
      </a>
    </div>

    <!-- Track Record Strip -->
    <div class="exec-telemetry-strip" aria-label="Track Record">
      <div class="exec-telemetry-cell">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Capital Funded</span>
        <span class="font-display font-bold text-xl sm:text-2xl text-on-surface">$100M+ Funded</span>
        <span class="text-[11px] text-on-surface-muted">Personally funded MCA &amp; RBF deals</span>
      </div>
      <div class="exec-telemetry-cell">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Experience</span>
        <span class="font-display font-bold text-xl sm:text-2xl text-on-surface">15+ Years</span>
        <span class="text-[11px] text-on-surface-muted">Alternative lending &amp; AI workflows</span>
      </div>
      <div class="exec-telemetry-cell">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Past Leadership</span>
        <span class="font-display font-bold text-xl sm:text-2xl text-on-surface">Whetstone Holdings</span>
        <span class="text-[11px] text-on-surface-muted">Former VP &amp; Board · Everest / Vader / Granite</span>
      </div>
      <div class="exec-telemetry-cell">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-on-surface-subtle">Current Role</span>
        <span class="font-display font-bold text-xl sm:text-2xl text-on-surface">CRO · MCF</span>
        <span class="text-[11px] text-on-surface-muted">My Commercial Funding · Morristown, NJ</span>
      </div>
    </div>
  </section>

  <!-- 2. Quick Guide -->
  <section class="flex flex-col gap-5">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <p class="exec-kicker mb-1.5">Quick Guide</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface tracking-tight">
          Not Sure Where to Start?
        </h2>
      </div>
      <p class="text-xs font-mono uppercase tracking-[0.12em] text-on-surface-subtle">
        NJ · NYC · FL · CT · MA · MD &amp; Remote
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <a href="/fractional-fde" class="exec-bento-card exec-bento-card-indigo flex items-start gap-3.5 no-underline group">
        <div class="link-row-icon text-accent group-hover:scale-105">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-sm text-on-surface">AI Deployment (FDE)</h3>
            <span class="exec-badge exec-badge-indigo">Build</span>
          </div>
          <p class="text-xs text-on-surface-muted mt-1 leading-relaxed">
            Embed AI agents into Salesforce, NetSuite, HubSpot &amp; funding platforms without migrations.
          </p>
        </div>
      </a>

      <a href="/fractional-caio" class="exec-bento-card exec-bento-card-violet flex items-start gap-3.5 no-underline group">
        <div class="link-row-icon text-violet-500 dark:text-violet-400 group-hover:scale-105">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-sm text-on-surface">AI Strategy (CAIO)</h3>
            <span class="exec-badge exec-badge-violet">90-Day C.A.P.™</span>
          </div>
          <p class="text-xs text-on-surface-muted mt-1 leading-relaxed">
            Executive AI Council governance, prioritized roadmaps &amp; CFO-defensible ROI.
          </p>
        </div>
      </a>

      <a href="#capital-advisory" class="exec-bento-card exec-bento-card-gold flex items-start gap-3.5 no-underline group">
        <div class="link-row-icon text-gold group-hover:scale-105">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-sm text-on-surface">Funding &amp; Capital</h3>
            <span class="exec-badge exec-badge-gold">$100M+ Track</span>
          </div>
          <p class="text-xs text-on-surface-muted mt-1 leading-relaxed">
            Direct lending setup, underwriting risk models, ISO networks &amp; loan offer review.
          </p>
        </div>
      </a>

      <a href="/richard-mckellar" class="exec-bento-card flex items-start gap-3.5 no-underline group">
        <div class="link-row-icon text-telemetry group-hover:scale-105">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-sm text-on-surface">Richard McKellar Bio</h3>
            <span class="exec-badge exec-badge-emerald">Profile</span>
          </div>
          <p class="text-xs text-on-surface-muted mt-1 leading-relaxed">
            Full background, Whetstone Holdings history, credentials &amp; career timeline.
          </p>
        </div>
      </a>

      <a href="/ventures" class="exec-bento-card flex items-start gap-3.5 no-underline group">
        <div class="link-row-icon text-accent group-hover:scale-105">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-sm text-on-surface">Companies &amp; Ventures</h3>
            <span class="exec-badge">6 Companies</span>
          </div>
          <p class="text-xs text-on-surface-muted mt-1 leading-relaxed">
            My Commercial Funding, The Institute for AI Adoption, Robbi Promotional &amp; more.
          </p>
        </div>
      </a>

      <a href="/case-studies" class="exec-bento-card flex items-start gap-3.5 no-underline group">
        <div class="link-row-icon text-teal-500 dark:text-teal-400 group-hover:scale-105">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-sm text-on-surface">Case Studies</h3>
            <span class="exec-badge exec-badge-teal">Results</span>
          </div>
          <p class="text-xs text-on-surface-muted mt-1 leading-relaxed">
            Real examples of AI underwriting triage, ERP integrations &amp; lending growth.
          </p>
        </div>
      </a>
    </div>
  </section>

  <!-- 3. How Richard Helps -->
  <section id="focus" class="flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <p class="exec-kicker mb-1.5">What I Do</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface tracking-tight">
          How We Can Work Together
        </h2>
        <p class="text-sm text-on-surface-muted mt-1.5 max-w-2xl">
          Practical AI leadership, hands-on engineering, and 15+ years of commercial lending experience—without the fluff.
        </p>
      </div>
      <a href="/fractional-caio-vs-fde" class="text-xs font-mono uppercase tracking-wider text-accent hover:underline no-underline flex-shrink-0">
        Compare CAIO vs FDE →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
      <!-- Pillar 1: Fractional Chief AI Officer -->
      <SpokeCard
        accent="purple"
        title="Fractional Chief AI Officer (CAIO)"
        badge="90-Day C.A.P.™"
        description="Senior AI leadership without a full-time executive salary. Richard puts a practical 90-day AI plan in place with clear governance, priority projects, and measurable ROI."
        links={[
          { label: 'Explore Fractional CAIO', href: '/fractional-caio' },
          { label: 'The Institute for AI Adoption', href: '/institute-for-ai-adoption' },
          { label: 'Compare Fractional CAIO vs FDE', href: '/fractional-caio-vs-fde' },
          { label: 'Schedule a 30-Min Call', href: 'https://calendar.mckellar.dev/richard/30min' },
        ]}
        useCases={[
          "Internal AI Council & clear rules of the road",
          "Prioritized 90-day C.A.P.™ AI plan",
          "ROI tracking tied to real numbers",
          "Team training so your staff owns it"
        ]}
        animationDelay={80}
        ctaLabel="Ask about Fractional CAIO"
        inquirySubject="Fractional Chief AI Officer Inquiry"
        inquirySource="spoke-fractional-caio"
      />

      <!-- Pillar 2: Fractional Forward Deployed Engineer -->
      <SpokeCard
        accent="blue"
        title="Fractional Forward Deployed Engineer"
        badge="Hands-On Builds"
        description="Hands-on engineering to map your workflows and build custom AI tools directly inside the software you already use—Salesforce, NetSuite, HubSpot, SAP, or lending CRMs."
        links={[
          { label: 'Explore Fractional FDE', href: '/fractional-fde' },
          { label: 'See Real Case Studies', href: '/case-studies' },
          { label: 'Hermes Agent Tools', href: 'https://hermes.mckellar.dev' },
          { label: 'Book a 30-Min Scoping Call', href: 'https://calendar.mckellar.dev/richard/30min' },
        ]}
        useCases={[
          "Workflow audit & clear ROI breakdown",
          "Custom integrations for Salesforce, NetSuite & HubSpot",
          "Tested safely in shadow mode before going live",
          "Clean documentation & full handoff to your team"
        ]}
        animationDelay={140}
        ctaLabel="Ask about Fractional FDE"
        inquirySubject="Fractional FDE Inquiry"
        inquirySource="spoke-fractional-fde"
      />

      <!-- Pillar 3: Capital & MCA Advisory -->
      <div class="flex flex-col" id="capital-advisory">
        <SpokeCard
          accent="gold"
          title="Capital &amp; MCA Advisory"
          badge="15+ Yrs · $100M+"
          description="15+ years in alternative lending and commercial finance. Advising direct lenders, brokerages, and business owners looking for an honest review of their loan terms."
          links={[
            { label: 'My Commercial Funding (CRO)', href: 'https://mycommercialfunding.com' },
            { label: 'Direct Lending Setup Advisory', href: '#inquire', inquirySubject: 'Direct Lending Setup Advisory', inquirySource: 'spoke-direct-lending' },
            { label: 'Brokerage & ISO Scaling', href: '#inquire', inquirySubject: 'Brokerage Operations Advisory', inquirySource: 'spoke-brokerage' },
            { label: 'Borrower Loan Offer Review', href: '#inquire', inquirySubject: 'Borrower-Side Funding Offer Review', inquirySource: 'spoke-borrower-review' },
          ]}
          useCases={[
            "Direct lending launch, underwriting & risk models",
            "Brokerage operations & ISO sales channels",
            "Salesforce & custom lending CRM builds",
            "Warehouse lines, syndication & loan offer review"
          ]}
          animationDelay={200}
          ctaLabel="Ask about Capital & Advisory"
          inquirySubject="Capital & Advisory Inquiry"
          inquirySource="spoke-capital-advisory"
        />
      </div>

      <!-- Pillar 4: AI Audits & Team Training -->
      <SpokeCard
        accent="teal"
        title="AI Audits &amp; Team Training"
        badge="$999 AI Audit"
        description="Fast single-workflow audits, automated lead routing, and practical workshops that help your sales and ops teams save hours every week."
        links={[
          { label: 'Read the Blog', href: '/blog' },
          { label: 'Team AI Training & Workshops', href: '#inquire', inquirySubject: 'Workforce AI Training Inquiry', inquirySource: 'spoke-workforce-training' },
          { label: 'Speaking & Media Kit', href: '/speaking-and-media' },
          { label: 'Promo & Custom Merch', href: '#inquire', inquirySubject: 'Promo & Merch Advisory Inquiry', inquirySource: 'spoke-promo-merch' },
        ]}
        useCases={[
          "$999 5–7 day audit on 1 workflow in 1 system",
          "Automated lead scoring & instant CRM routing",
          "Speaking & leadership workshops",
          "Operations & process troubleshooting"
        ]}
        animationDelay={260}
        ctaLabel="Ask about AI Audits & Training"
        inquirySubject="AI Consulting Inquiry"
        inquirySource="spoke-ai-consulting"
      />
    </div>
  </section>

  <!-- 4. Ventures & Background -->
  <section id="ventures" class="flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <p class="exec-kicker mb-1.5">Companies &amp; Roles</p>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-on-surface tracking-tight">
          Where I Work &amp; What I&apos;ve Built
        </h2>
      </div>
      <a href="/ventures" class="text-xs font-mono uppercase tracking-wider text-accent hover:underline no-underline">
        See All Ventures →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <a
        href="https://mycommercialfunding.com"
        target="_blank"
        rel="me author noopener noreferrer"
        id="link-my-commercial-funding"
        class="exec-bento-card exec-bento-card-gold flex items-start gap-4 no-underline group"
      >
        <div class="link-row-icon text-gold bg-[var(--color-gold-dim)] border-amber-500/25">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-base text-on-surface">My Commercial Funding</h3>
            <span class="exec-badge exec-badge-gold">CRO</span>
          </div>
          <p class="text-[11px] font-mono uppercase tracking-wider text-on-surface-subtle mt-0.5">
            Chief Revenue Officer · Commercial Lending &amp; MCA Platform
          </p>
          <p class="text-xs text-on-surface-muted mt-2 leading-relaxed">
            Directing revenue pipelines, ISO channel architecture, commission routing, renewal cycles, and syndication network operations.
          </p>
        </div>
      </a>

      <a
        href="/institute-for-ai-adoption"
        class="exec-bento-card exec-bento-card-violet flex items-start gap-4 no-underline group"
      >
        <div class="link-row-icon text-violet-500 dark:text-violet-400 bg-[var(--color-violet-dim)] border-violet-500/25">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-display font-bold text-base text-on-surface">The Institute for AI Adoption</h3>
            <span class="exec-badge exec-badge-violet">Founder · CAIO</span>
          </div>
          <p class="text-[11px] font-mono uppercase tracking-wider text-on-surface-subtle mt-0.5">
            Operational AI Facilitation · Companies &amp; Governments
          </p>
          <p class="text-xs text-on-surface-muted mt-2 leading-relaxed">
            Deploying the proprietary 90-day C.A.P.™ Operating Model (Council, Align, Perform) to establish internal AI governance and measurable ROI.
          </p>
        </div>
      </a>

      <a
        href="/about"
        class="exec-bento-card flex items-start gap-4 no-underline group"
      >
        <div class="link-row-icon text-accent">
